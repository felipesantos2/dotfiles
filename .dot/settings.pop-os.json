// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1100
    }
  },
  "disable_ai": true,
  "edit_predictions": {
    "provider": "zed"
  },
  "buffer_line_height": {
    "custom": 1.8,
  },
  "cursor_shape": "hollow",
  "languages": {
    "Shell Script": {
      "indent_guides": {
        "background_coloring": "indent_aware",
      },
      "hard_tabs": true,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "4"]
        }
      }
    },
    "Python": {
      "language_servers": [
        "ty",
        "ruff"
      ],
      "indent_guides": {
        "background_coloring": "indent_aware",
      },
      "hard_tabs": true,
      "format_on_save": "on",
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato"
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Soft",
  },
}
