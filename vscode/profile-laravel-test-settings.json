{
    "editor.fontFamily": "JetBrains Mono",
    "editor.lineHeight": 2.1,
    "editor.renderLineHighlight": "gutter",
    "editor.fontLigatures": true,
    "workbench.editor.labelFormat": "short",
    "editor.minimap.enabled": false,
    "files.autoSave": "afterDelay",
    "workbench.startupEditor": "newUntitledFile",
    "workbench.statusBar.visible": true,
    "workbench.tree.indent": 25,
    "editor.lineNumbers": "interval",
    "editor.cursorSmoothCaretAnimation": "off",
    "editor.cursorStyle": "block-outline",
    "editor.rulers": [
        70,
        120
    ],
    "explorer.compactFolders": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.inlineSuggest.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.selectedCompletionModel": "",
    "diffEditor.ignoreTrimWhitespace": false,
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "terminal.integrated.profiles.windows": {
        "Cmder": {
            "path": "${env:windir}\\System32\\cmd.exe",
            "args": [
                "/k",
                "C:\\laragon\\bin\\cmder\\vendor\\bin\\vscode_init.cmd"
            ]
        },
    },
    "terminal.integrated.defaultProfile.windows": "Cmder",
    "trailing-spaces.backgroundColor": "rgb(28, 90, 148)",
    "security.workspace.trust.untrustedFiles": "open",
    "css.lint.unknownAtRules": "ignore",
    "files.associations": {
        "*.php": "php",
        "*.blade.php": "blade"
    },
    "intelephense.stubs": [
        "apache",
        "bcmath",
        "bz2",
        "calendar",
        "com_dotnet",
        "Core",
        "ctype",
        "curl",
        "date",
        "dba",
        "dom",
        "enchant",
        "exif",
        "FFI",
        "fileinfo",
        "filter",
        "fpm",
        "ftp",
        "gd",
        "gettext",
        "gmp",
        "hash",
        "iconv",
        "imap",
        "intl",
        "json",
        "ldap",
        "libxml",
        "mbstring",
        "meta",
        "mysqli",
        "oci8",
        "odbc",
        "openssl",
        "pcntl",
        "pcre",
        "PDO",
        "pdo_ibm",
        "pdo_mysql",
        "pdo_pgsql",
        "pdo_sqlite",
        "pgsql",
        "Phar",
        "posix",
        "pspell",
        "random",
        "readline",
        "Reflection",
        "session",
        "shmop",
        "SimpleXML",
        "snmp",
        "soap",
        "sockets",
        "sodium",
        "SPL",
        "sqlite3",
        "standard",
        "superglobals",
        "sysvmsg",
        "sysvsem",
        "sysvshm",
        "tidy",
        "tokenizer",
        "xml",
        "xmlreader",
        "xmlrpc",
        "xmlwriter",
        "xsl",
        "Zend OPcache",
        "zip",
        "zlib",
        "wordpress"
    ],
    "workbench.iconTheme": "catppuccin-frappe",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "php": false
    },
    "editor.formatOnSave": true,
    "tailwindCSS.emmetCompletions": true,
    "[html]": {
        "editor.suggest.insertMode": "replace",
        "editor.autoClosingBrackets": "always"
    },
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.largeFileOptimizations": false,
    "files.saveConflictResolution": "overwriteFileOnDisk",
    "terminal.integrated.hideOnStartup": "whenEmpty",
    "terminal.integrated.lineHeight": 1.4,
    "window.zoomPerWindow": false,
    "extensions.ignoreRecommendations": true,
    "editor.renderWhitespace": "none",
    "git.ignoreRebaseWarning": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "chat.agent.maxRequests": 24,
    "chat.tools.terminal.autoApprove": {
        "git add": true,
        "git commit": true,
        "vendor/bin/sail": true
    },
    "inlineChat.notebookAgent": true,
    "chat.agent.codeBlockProgress": true,
    "chat.agentSessionsViewLocation": "single-view",
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "Laravel.showErrorPopups": false,
    "terminal.integrated.fontFamily": "monospace",
    "chat.tools.terminal.outputLocation": "chat",
    "[dockercompose]": {
        "editor.defaultFormatter": "docker.docker"
    },
    "workbench.navigationControl.enabled": false,
    "workbench.productIconTheme": "fluent-icons",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.fontSize": 15,
    "git.openRepositoryInParentFolders": "always",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.showTabIndex": true,
    "git.addAICoAuthor": "off",
    "github.copilot.chat.cli.aiGenerateBranchNames.enabled": false,
    "terminal.integrated.initialHint": false,
    "chat.unifiedAgentsBar.enabled": true,
    "chat.agentSessionProjection.enabled": true,
    "remote.autoForwardPortsSource": "hybrid",
    "workbench.activityBar.compact": true,
    "workbench.sideBar.location": "right",
    "chat.viewSessions.orientation": "stacked",
    "github.copilot.nextEditSuggestions.eagerness": "low",
    "workbench.browser.openLocalhostLinks": false,
    "window.commandCenter": false,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "editor.aiStats.enabled": true,
    "terminal.integrated.fontLigatures.enabled": true,
    "workbench.browser.showInTitleBar": false,
    "workbench.layoutControl.enabled": false,
    "terminal.integrated.fontSize": 15,
    "liveServer.settings.donotShowInfoMsg": true,
    "explorer.confirmDelete": false,
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://livewire.laravel.com": {
            "approveRequest": false,
            "approveResponse": true
        }
    },
    "workbench.colorTheme": "Rosé Pine"
}
